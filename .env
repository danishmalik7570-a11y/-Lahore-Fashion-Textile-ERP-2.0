# ─────────────────────────────────────────────────────────────────────────────
# Lahore Fashion Textile ERP — Environment Variables Template
# Copy this to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_50_char_random_string_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
APP_VERSION=1.0.0

# ── Database (PostgreSQL 16) ───────────────────────────────────────────────────
POSTGRES_DB=lahorefashion
POSTGRES_USER=lfuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://lfuser:change_me_strong_password@localhost:5432/lahorefashion
CONN_MAX_AGE=60

# ── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_redis_password@redis:6379/2

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_NAME=lf-erp
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=4
GUNICORN_WORKERS=4

# ── Ports ─────────────────────────────────────────────────────────────────────
DJANGO_PORT=8000
FASTAPI_PORT=8001
HTTP_PORT=80
HTTPS_PORT=443

# ── Email (dev: console | prod: anymail/mailgun) ──────────────────────────────
DEFAULT_FROM_EMAIL=noreply@lahorefashion.com
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── SSO (Google + Microsoft) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Sentry (error tracking) ───────────────────────────────────────────────────
SENTRY_DSN=

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated IPs allowed to access admin (leave empty = all)
ADMIN_IP_ALLOWLIST=

# ── First Superuser (for seed command) ───────────────────────────────────────
DJANGO_SUPERUSER_EMAIL=owner@lahorefashion.com
DJANGO_SUPERUSER_PASSWORD=ChangeMe@12345
DJANGO_SUPERUSER_NAME=Owner Admin

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Auth & Security Flags ─────────────────────────────────────────────────────
AUTH_2FA_ENABLED=false
AUTH_STEP_UP_ENABLED=false
